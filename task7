# Final Comparison
# In this task, we compare Histogram Equalization, CLAHE,
# and Histogram Matching on images.
# Input: source.jpg and reference.jpg
# Output: Original, Equalized, CLAHE, and Matched images.

import cv2
import numpy as np
import matplotlib.pyplot as plt
def histogram_equalization(image):
    hist = np.bincount(image.ravel(), minlength=256)

    cdf = hist.cumsum()

    cdf_min = cdf[cdf > 0].min()
    lookup = ((cdf - cdf_min) * 255 /
              (cdf[-1] - cdf_min)).astype(np.uint8)

    equalized = lookup[image]

    return equalized
def histogram_matching(source, reference):

    source_hist = np.bincount(source.ravel(), minlength=256)
    reference_hist = np.bincount(reference.ravel(), minlength=256)

    source_cdf = source_hist.cumsum()
    reference_cdf = reference_hist.cumsum()

    source_cdf = source_cdf / source_cdf[-1]
    reference_cdf = reference_cdf / reference_cdf[-1]

    mapping = np.zeros(256, dtype=np.uint8)

    for i in range(256):
        mapping[i] = np.argmin(
            np.abs(reference_cdf - source_cdf[i])
        )

    return mapping[source]

source = cv2.imread("source.jpg", 0)
reference = cv2.imread("reference.jpg", 0)
if source is None:
    print("source.jpg not found!")

elif reference is None:
    print("reference.jpg not found!")

else:
    equalized = histogram_equalization(source)

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    clahe_image = clahe.apply(source)

    matched = histogram_matching(source, reference)
    plt.figure(figsize=(12, 8))

    plt.subplot(2, 4, 1)
    plt.imshow(source, cmap="gray")
    plt.title("Original")
    plt.axis("off")

    plt.subplot(2, 4, 2)
    plt.imshow(equalized, cmap="gray")
    plt.title("Histogram Equalization")
    plt.axis("off")

    plt.subplot(2, 4, 3)
    plt.imshow(clahe_image, cmap="gray")
    plt.title("CLAHE")
    plt.axis("off")

    plt.subplot(2, 4, 4)
    plt.imshow(matched, cmap="gray")
    plt.title("Histogram Matching")
    plt.axis("off")
    plt.subplot(2, 4, 5)
    plt.hist(source.ravel(), 256, [0, 256], color="black")
    plt.title("Original Histogram")

    plt.subplot(2, 4, 6)
    plt.hist(equalized.ravel(), 256, [0, 256], color="black")
    plt.title("Equalized Histogram")

    plt.subplot(2, 4, 7)
    plt.hist(clahe_image.ravel(), 256, [0, 256], color="black")
    plt.title("CLAHE Histogram")

    plt.subplot(2, 4, 8)
    plt.hist(matched.ravel(), 256, [0, 256], color="black")
    plt.title("Matched Histogram")

    plt.tight_layout()
    plt.show()