import cv2
import numpy as np

img1 = cv2.imread("1.jpg")
img2 = cv2.imread("2.jpg")

if img1 is None or img2 is None:
    print("Error: Images not found!")
    exit()

gray1 = cv2.cvtColor(img1, cv2.COLOR_BGR2GRAY)
gray2 = cv2.cvtColor(img2, cv2.COLOR_BGR2GRAY)

orb = cv2.ORB_create(nfeatures=1500)

keypoints1, descriptors1 = orb.detectAndCompute(gray1, None)
keypoints2, descriptors2 = orb.detectAndCompute(gray2, None)

print("FEATURE DETECTION ")
print("Keypoints in Image 1:", len(keypoints1))
print("Keypoints in Image 2:", len(keypoints2))

bf = cv2.BFMatcher(
    cv2.NORM_HAMMING,
    crossCheck=False
)

# ==========================================
# 5. KNN MATCHING
# ==========================================

matches = bf.knnMatch(
    descriptors1,
    descriptors2,
    k=2
)

print("\n========== MATCHING ==========")
print("Total KNN Matches:", len(matches))
good_matches = []

for m, n in matches:

    if m.distance < 0.75 * n.distance:
        good_matches.append(m)

print("Good Matches after Ratio Test:", len(good_matches))

if len(good_matches) < 4:

    print("\nNot enough matches for RANSAC!")
    cv2.waitKey(0)
    cv2.destroyAllWindows()
    exit()

src_pts = np.float32([
    keypoints1[m.queryIdx].pt
    for m in good_matches
]).reshape(-1, 1, 2)

dst_pts = np.float32([
    keypoints2[m.trainIdx].pt
    for m in good_matches
]).reshape(-1, 1, 2)

homography, mask = cv2.findHomography(
    src_pts,
    dst_pts,
    cv2.RANSAC,
    5.0
)

ransac_matches = []

for i, match in enumerate(good_matches):

    if mask[i]:
        ransac_matches.append(match)

print("\nRANSAC Results:")
print("Good Matches:", len(good_matches))
print("RANSAC Inliers:", len(ransac_matches))
print("Outliers Removed:",
      len(good_matches) - len(ransac_matches))

final_result = cv2.drawMatches(
    img1,
    keypoints1,
    img2,
    keypoints2,
    ransac_matches,
    None,
    flags=cv2.DrawMatchesFlags_NOT_DRAW_SINGLE_POINTS
)

cv2.putText(
    final_result,
    "Final Feature Matching - RANSAC Inliers",
    (20, 40),
    cv2.FONT_HERSHEY_SIMPLEX,
    1,
    (0, 255, 0),
    2
)

cv2.imshow(
    "Feature Matching Mini Project",
    final_result
)

cv2.waitKey(0)
cv2.destroyAllWindows()