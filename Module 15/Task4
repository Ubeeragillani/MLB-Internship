import numpy as np
def mse(y_true, y_pred):
    return np.mean((y_true - y_pred) ** 2)
def binary_cross_entropy(y_true, y_pred):
    epsilon = 1e-15
    y_pred = np.clip(y_pred, epsilon, 1 - epsilon)
    return -np.mean(
        y_true * np.log(y_pred) +
        (1 - y_true) * np.log(1 - y_pred)
    )
def categorical_cross_entropy(y_true, y_pred):
    epsilon = 1e-15
    y_pred = np.clip(y_pred, epsilon, 1 - epsilon)

    return -np.sum(y_true * np.log(y_pred))
y_true = np.array([1, 0, 1, 1])
y_pred = np.array([0.8, 0.2, 0.6, 0.9])

mse_loss = mse(y_true, y_pred)

print("MSE Loss:", mse_loss)
y_true_binary = np.array([1, 0, 1, 1])
y_pred_binary = np.array([0.8, 0.2, 0.6, 0.9])
bce_loss = binary_cross_entropy(
    y_true_binary,
    y_pred_binary
)
print("Binary Cross-Entropy Loss:", bce_loss)
y_true_categorical = np.array([
    [1, 0, 0],
    [0, 1, 0],
    [0, 0, 1]
])
y_pred_categorical = np.array([
    [0.7, 0.2, 0.1],
    [0.1, 0.8, 0.1],
    [0.2, 0.2, 0.6]
])
cce_loss = categorical_cross_entropy(
    y_true_categorical,
    y_pred_categorical
)
print("Categorical Cross-Entropy Loss", cce_loss)