import numpy as np
X = np.array([[1, 2]])
W1 = np.array([
    [0.5, 0.2],
    [0.3, 0.4]
])
b1 = np.array([0.1, 0.2])
W2 = np.array([
    [0.6],
    [0.7]
])
b2 = np.array([0.1])
z1 = np.dot(X, W1) + b1
a1 = np.maximum(0, z1)
z2 = np.dot(a1, W2) + b2
output = 1 / (1 + np.exp(-z2))
print("Input", X)
print("Hidden Layer Weighted Sum", z1)
print("Hidden Layer Output", a1)
print("Output Layer Weighted Sum", z2)
print("Final Output", output)