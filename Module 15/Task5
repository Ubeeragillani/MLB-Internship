import numpy as np
X = np.array([1, 2, 3, 4])
y = np.array([3, 5, 7, 9])
w = 0.0
b = 0.0
learning_rate = 0.01
epochs = 1000
for epoch in range(epochs):
    y_pred = w * X + b
    loss = np.mean((y - y_pred) ** 2)
    dw = (-2 / len(X)) * np.sum(X * (y - y_pred))
    db = (-2 / len(X)) * np.sum(y - y_pred)
    w = w - learning_rate * dw
    b = b - learning_rate * db
    if epoch % 100 == 0:
        print(
            "Epoch:", epoch,
            "Loss:", loss,
            "Weight:", w,
            "Bias:", b
        )
print("Final Weight:", w)
print("Final Bias:", b)