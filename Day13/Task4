import cv2
import numpy as np
import matplotlib.pyplot as plt

img1 = cv2.imread("reference.jpg")
img2 = cv2.imread("ref1.jpg")

if img1 is None or img2 is None:
    raise FileNotFoundError("Could not load reference.jpg or ref1.jpg")

img1_rgb = cv2.cvtColor(img1, cv2.COLOR_BGR2RGB)
img2_rgb = cv2.cvtColor(img2, cv2.COLOR_BGR2RGB)

src_points = np.float32([
    [100, 100],
    [500, 100],
    [500, 400],
    [100, 400]
])

dst_points = np.float32([
    [120, 80],
    [520, 120],
    [480, 430],
    [80, 380]
])

H = cv2.getPerspectiveTransform(src_points, dst_points)

height, width = img2.shape[:2]

H_inv = np.linalg.inv(H)

warped_numpy = np.zeros_like(img2)

y_coords, x_coords = np.indices((height, width))

ones = np.ones_like(x_coords)

destination_points = np.stack(
    [x_coords, y_coords, ones],
    axis=-1
).reshape(-1, 3).T

source_points = H_inv @ destination_points

source_points = source_points / source_points[2]

src_x = np.round(source_points[0]).astype(int)
src_y = np.round(source_points[1]).astype(int)

valid = (
    (src_x >= 0) &
    (src_x < img1.shape[1]) &
    (src_y >= 0) &
    (src_y < img1.shape[0])
)

warped_flat = warped_numpy.reshape(-1, 3)

warped_flat[valid] = img1[
    src_y[valid],
    src_x[valid]
]

warped_numpy = warped_flat.reshape(height, width, 3)

warped_opencv = cv2.warpPerspective(
    img1,
    H,
    (width, height)
)

warped_numpy_rgb = cv2.cvtColor(
    warped_numpy,
    cv2.COLOR_BGR2RGB
)

warped_opencv_rgb = cv2.cvtColor(
    warped_opencv,
    cv2.COLOR_BGR2RGB
)

plt.figure(figsize=(15, 8))

plt.subplot(2, 2, 1)
plt.imshow(img1_rgb)
plt.title("Source Image")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(img2_rgb)
plt.title("Target Image")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(warped_numpy_rgb)
plt.title("NumPy Coordinate Mapping")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(warped_opencv_rgb)
plt.title("OpenCV warpPerspective")
plt.axis("off")

plt.tight_layout()
plt.show()