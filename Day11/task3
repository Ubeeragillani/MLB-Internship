# Task 3: RGB Histogram
# This task separates an RGB image into Red, Green, and Blue
# channels and plots a separate histogram for each channel.
# Input: RGB image (nature.jpg)
# Output: R, G, and B channel histograms showing pixel intensity distribution.
import cv2
import matplotlib.pyplot as plt
image = cv2.imread("nature.jpg")
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
R, G, B = cv2.split(image_rgb)
plt.figure(figsize=(10, 6))
plt.hist(R.ravel(), bins=256, color="red", alpha=0.7, label="Red")
plt.hist(G.ravel(), bins=256, color="green", alpha=0.7, label="Green")
plt.hist(B.ravel(), bins=256, color="blue", alpha=0.7, label="Blue")
plt.title("RGB Histogram")
plt.xlabel("Pixel Intensity")
plt.ylabel("Frequency")
plt.legend()
plt.xlim([0, 256])

plt.show()