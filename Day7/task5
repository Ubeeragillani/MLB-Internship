import cv2
import matplotlib.pyplot as plt
import os
image_path = os.path.join(os.path.dirname(__file__), "flower.jpg")
image = cv2.imread(image_path)

if image is None:
    print("Image not found!")
    exit()
noisy = image.copy()
noise = cv2.randn(noisy.copy(), (0, 0, 0), (25, 25, 25))
noisy = cv2.add(noisy, noise)
mean = cv2.blur(noisy, (5, 5))
gaussian = cv2.GaussianBlur(noisy, (5, 5), 0)
median = cv2.medianBlur(noisy, 5)
bilateral = cv2.bilateralFilter(noisy, 9, 75, 75)
original_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
noisy_rgb = cv2.cvtColor(noisy, cv2.COLOR_BGR2RGB)
mean_rgb = cv2.cvtColor(mean, cv2.COLOR_BGR2RGB)
gaussian_rgb = cv2.cvtColor(gaussian, cv2.COLOR_BGR2RGB)
median_rgb = cv2.cvtColor(median, cv2.COLOR_BGR2RGB)
bilateral_rgb = cv2.cvtColor(bilateral, cv2.COLOR_BGR2RGB)
plt.figure(figsize=(15, 10))
plt.subplot(2,3,1)
plt.imshow(original_rgb)
plt.title("Original")
plt.axis("off")
plt.subplot(2,3,2)
plt.imshow(noisy_rgb)
plt.title("Noisy")
plt.axis("off")
plt.subplot(2,3,3)
plt.imshow(mean_rgb)
plt.title("Mean Filter")
plt.axis("off")
plt.subplot(2,3,4)
plt.imshow(gaussian_rgb)
plt.title("Gaussian Filter")
plt.axis("off")
plt.subplot(2,3,5)
plt.imshow(median_rgb)
plt.title("Median Filter")
plt.axis("off")
plt.subplot(2,3,6)
plt.imshow(bilateral_rgb)
plt.title("Bilateral Filter")
plt.axis("off")
plt.tight_layout()
plt.show()
cv2.imwrite("noisy_image.jpg", noisy)
cv2.imwrite("mean_filter.jpg", mean)
cv2.imwrite("gaussian_filter.jpg", gaussian)
cv2.imwrite("median_filter.jpg", median)
cv2.imwrite("bilateral_filter.jpg", bilateral)
print("Comparison Table")
print("{:<18} {:<18} {:<18} {:<12} {:<25}".format(
    "Filter", "Noise Removal", "Edge Preservation", "Blur", "Best Use Case"))
print("-"*95)
print("{:<18} {:<18} {:<18} {:<12} {:<25}".format(
    "Mean", "Good", "Poor", "High", "Simple smoothing"))
print("{:<18} {:<18} {:<18} {:<12} {:<25}".format(
    "Gaussian", "Very Good", "Fair", "Medium", "Gaussian noise"))
print("{:<18} {:<18} {:<18} {:<12} {:<25}".format(
    "Median", "Excellent", "Very Good", "Low", "Salt & Pepper noise"))
print("{:<18} {:<18} {:<18} {:<12} {:<25}".format(
    "Bilateral", "Good", "Excellent", "Very Low", "Edge preservation"))