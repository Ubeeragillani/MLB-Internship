import cv2
import numpy as np
import matplotlib.pyplot as plt
import time
import os
image_path = os.path.join(os.path.dirname(__file__), "flower.jpg")
image = cv2.imread(image_path)
if image is None:
    print("Image not found!")
    exit()
noise = np.zeros_like(image)
cv2.randn(noise, (0, 0, 0), (25, 25, 25))
noisy = cv2.add(image, noise)
kernel_sizes = [3, 5, 7]
for k in kernel_sizes:
    print("\n" + "=" * 60)
    print(f"Kernel Size: {k} x {k}")
    print("=" * 60)
    start = time.time()
    mean = cv2.blur(noisy, (k, k))
    mean_time = time.time() - start
    start = time.time()
    gaussian = cv2.GaussianBlur(noisy, (k, k), 0)
    gaussian_time = time.time() - start
    start = time.time()
    median = cv2.medianBlur(noisy, k)
    median_time = time.time() - start
    start = time.time()
    bilateral = cv2.bilateralFilter(noisy, k, 75, 75)
    bilateral_time = time.time() - start
    noisy_rgb = cv2.cvtColor(noisy, cv2.COLOR_BGR2RGB)
    mean_rgb = cv2.cvtColor(mean, cv2.COLOR_BGR2RGB)
    gaussian_rgb = cv2.cvtColor(gaussian, cv2.COLOR_BGR2RGB)
    median_rgb = cv2.cvtColor(median, cv2.COLOR_BGR2RGB)
    bilateral_rgb = cv2.cvtColor(bilateral, cv2.COLOR_BGR2RGB)
    plt.figure(figsize=(15, 5))
    plt.subplot(1, 5, 1)
    plt.imshow(noisy_rgb)
    plt.title("Noisy")
    plt.axis("off")
    plt.subplot(1, 5, 2)
    plt.imshow(mean_rgb)
    plt.title(f"Mean {k}x{k}")
    plt.axis("off")
    plt.subplot(1, 5, 3)
    plt.imshow(gaussian_rgb)
    plt.title(f"Gaussian {k}x{k}")
    plt.axis("off")
    plt.subplot(1, 5, 4)
    plt.imshow(median_rgb)
    plt.title(f"Median {k}x{k}")
    plt.axis("off")
    plt.subplot(1, 5, 5)
    plt.imshow(bilateral_rgb)
    plt.title(f"Bilateral {k}x{k}")
    plt.axis("off")

    plt.tight_layout()
    plt.show()

    print("\nProcessing Time")
    print("-" * 40)
    print(f"Mean Filter      : {mean_time:.6f} seconds")
    print(f"Gaussian Filter  : {gaussian_time:.6f} seconds")
    print(f"Median Filter    : {median_time:.6f} seconds")
    print(f"Bilateral Filter : {bilateral_time:.6f} seconds")

print("\n" + "=" * 70)
print("OBSERVATIONS")
print("=" * 70)

print("\n3 × 3 Kernel")
print("Image Sharpness : High")
print("Noise Reduction : Low")
print("Blur Level      : Very Low")
print("Processing Time : Fast")

print("\n5 × 5 Kernel")
print("Image Sharpness : Good")
print("Noise Reduction : Medium")
print("Blur Level      : Moderate")
print("Processing Time : Moderate")

print("\n7 × 7 Kernel")
print("Image Sharpness : Lower")
print("Noise Reduction : High")
print("Blur Level      : High")
print("Processing Time : Slow")

print("\n" + "=" * 70)
print("CONCLUSION")
print("=" * 70)
print("1. 3x3 kernel preserves image details but removes less noise.")
print("2. 5x5 kernel provides the best balance between sharpness and smoothing.")
print("3. 7x7 kernel removes the most noise but produces the highest blur.")
print("4. Mean filter is the fastest but blurs edges.")
print("5. Gaussian filter gives smooth results with moderate blur.")
print("6. Median filter is best for Salt & Pepper noise.")
print("7. Bilateral filter preserves edges the best but is the slowest.")